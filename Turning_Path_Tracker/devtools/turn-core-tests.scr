(load (strcat (getenv "TURNDEV") "/turn-dev-paths.lsp"))
(setvar "cmdecho" 0)(setvar "filedia" 0)
(load (tt-dev "turn-tests.lsp"))(tt-start "TURN tracking kernel unit tests, drive kernel included")
(load (tt-src "turn.lsp"))(tt-capture-alerts)
(load (tt-dev "turn-drive-tests.lsp"))
(load (tt-dev "turn-core-tests.lsp"))(ttc-run-all)(tt-finish nil)
(tt-safe-quit)
quit
