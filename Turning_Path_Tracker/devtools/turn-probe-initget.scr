(load (strcat (getenv "TURNDEV") "/turn-dev-paths.lsp"))
(setvar "cmdecho" 0)(setvar "filedia" 0)
(load (turn-test-dev "turn-probe-initget.lsp"))(turn-probe-initget-begin)(turn-probe-initget-test-initget)
(turn-probe-initget-ask "exact hyphenated key typed")
WB-67
(turn-probe-initget-ask "lower case typed")
wb-62
(turn-probe-initget-ask "empty input (want nil so caller can default)")

(turn-probe-initget-ask "a key with two hyphens")
S-BUS-36
(turn-probe-initget-say "")(turn-probe-initget-say "END OF PROBE")
(turn-test-safe-quit)
quit
