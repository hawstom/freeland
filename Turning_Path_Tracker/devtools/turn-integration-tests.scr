(load (strcat (getenv "TURNDEV") "/turn-dev-paths.lsp"))
(setvar "cmdecho" 0)(setvar "filedia" 0)(setvar "attdia" 0)(setvar "attreq" 0)(setvar "blipmode" 0)
(load (turn-test-dev "turn-tests.lsp"))(turn-test-start "TURN 2.0.0-dev integration - tractor, trailer and pup")
(load (turn-test-src "turn.lsp"))
(load (turn-test-dev "turn-core-tests.lsp"))
(load (turn-test-dev "turn-integration-tests.lsp"))(turn-test-integration-run)(turn-test-finish (turn-test-dev "turn-integration-out.dwg"))
(turn-test-safe-quit)
quit
