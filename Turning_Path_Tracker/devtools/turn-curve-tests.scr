(load (strcat (getenv "TURNDEV") "/turn-dev-paths.lsp"))
(setvar "cmdecho" 0)(setvar "filedia" 0)(setvar "attdia" 0)(setvar "attreq" 0)(setvar "blipmode" 0)(setvar "osmode" 0)
(load (tt-dev "turn-tests.lsp"))(tt-start "TURN 2.0.0 - punch list item 7, any curve not just a polyline")
(load (tt-src "turn.lsp"))(tt-capture-alerts)
(load (tt-dev "turn-core-tests.lsp"))
(load (tt-dev "turn-curve-tests.lsp"))(tcv-run)(tt-finish (tt-dev "turn-curve-out.dwg"))
(tt-safe-quit)
quit
