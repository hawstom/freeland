(load (strcat (getenv "TURNDEV") "/turn-dev-paths.lsp"))
(setvar "cmdecho" 1)(setvar "filedia" 0)
(load (tt-dev "turn-getdist-probe.lsp"))(gp-start)
(gp-report "getdist typed -3" (getdist "\nProbe A, type -3: "))
-3
(gp-report "getdist typed 3" (getdist "\nProbe B, type 3: "))
3
(gp-report "getreal typed -3" (getreal "\nProbe C, type -3: "))
-3
(gp-done)
(tt-safe-quit)
